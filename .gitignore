# =========================================================================
# NetProbe Git Ignore Rules
# =========================================================================

# --- CMake / Build Outputs ---
/build*/
/out/
/bin/
/package/
/smoke/
/dist/
CMakeCache.txt
CMakeFiles/
CMakeSettings.json
CMakeUserPresets.json
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json
CPackConfig.cmake
CPackSourceConfig.cmake
_CPack_Packages/
*.zip
*.tar.gz
*.tgz
*.dmg
*.pkg

# --- Compiler, Linker, and Debug Files ---
*.o
*.obj
*.a
*.lib
*.la
*.lo
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app
*.pdb
*.ilk
*.idb
*.exp
*.d

# --- Visual Studio (MSVC) Artifacts ---
.vs/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.suo
*.user
*.ncb
*.sdf
*.opensdf
*.db
*.ipch
*.tlog
*.recipe

# --- IDEs (VS Code, CLion, etc.) ---
.vscode/
.idea/
*.iws
*.iml
*.ipr
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# --- Runtime / Application Output ---
# Written by the app at exit or CLI export; per-machine state.
imgui.ini
netprobe-layout.ini
netprobe-settings.ini
flows.json
flows.csv

# --- User-Captured Traffic & Test Data ---
# Keep intentionally versioned PCAP fixtures under tests/ instead.
*.pcap
*.pcapng
!/tests/**
!/data/README.md
/captures/
/exports/

# --- GeoIP Data and Local Secrets ---
# GeoLite databases are user-supplied/downloaded and must not be committed.
/data/*.mmdb
/data/*.mmdb.gz

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt
credentials*.json

# --- External & Dependency Cache ---
/external/*
!/external/README.md
/vcpkg_installed/
.conan/

# --- System / OS Specific ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# --- Agent Workspace Cache ---
/.agents/
/.gemini/
/.claude/
/.cursor/

# --- Local Planning & Scratch Documents ---
/plans/
*.scratch
*.tmp
*.temp
*.bak
*.orig
*~

# --- Demo Recording ---
/docs/record-demo.md

# --- libFuzzer & Crash Artifacts ---
crash-*
leak-*
oom-*
timeout-*
slow-unit-*
fuzz-*.log
core
core.*
*.dmp
